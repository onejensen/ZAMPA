# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
# Hardening del panel admin.
#
# La CSP está en Report-Only: registra violaciones en la consola de DevTools
# sin bloquear nada. Cuando se haya usado el panel entero (login email +
# Google, las 4 tabs, modal de verificación con mapa y fotos) sin violaciones,
# renombrar "Content-Security-Policy-Report-Only" a "Content-Security-Policy".
#
# Inventario que cubre cada directiva:
#   script-src   app.js local + SDK Firebase (gstatic) + gapi (apis.google.com,
#                lo carga signInWithPopup)
#   connect-src  Cloud Functions admin + auth REST (identitytoolkit/securetoken)
#   img-src      assets locales + fotos de comercios (Firebase Storage)
#   frame-src    iframe del popup de Google Auth (authDomain) + embed de Maps
#                (maps.google.com hace 301 a www.google.com/maps/embed, la CSP
#                valida ambas URLs del redirect)
#   style-src    'unsafe-inline' por el <style> del propio index.html

/admin
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'none'; script-src 'self' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://firebasestorage.googleapis.com; connect-src 'self' https://us-central1-eatout-70b8b.cloudfunctions.net https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://apis.google.com; frame-src https://eatout-70b8b.firebaseapp.com https://maps.google.com https://www.google.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'

/admin/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'none'; script-src 'self' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://firebasestorage.googleapis.com; connect-src 'self' https://us-central1-eatout-70b8b.cloudfunctions.net https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://apis.google.com; frame-src https://eatout-70b8b.firebaseapp.com https://maps.google.com https://www.google.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'
